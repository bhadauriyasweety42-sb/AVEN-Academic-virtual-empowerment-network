# Copy to .env and fill values locally. Never commit server/.env.
MONGO_URI=mongodb://replace-with-your-atlas-connection-string
GEMINI_API_KEY=replace-with-your-own-key
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=5000
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:your-email@example.com
